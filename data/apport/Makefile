install-dist_crashdbDATA: $(dist_crashdb_DATA)
	@$(NORMAL_INSTALL)
	@list='$(dist_crashdb_DATA)'; test -n "$(crashdbdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(crashdbdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(crashdbdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(crashdbdir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(crashdbdir)" || exit $$?; \
	done

