#!/usr/bin/env sh

# Start the out-of-tree project build of Dock-E for the desktop session.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
BUILD_DIR=${DOCK_E_BUILD_DIR:-"$PROJECT_DIR/.build"}
DOCK_E="$BUILD_DIR/src/.libs/plank"
LIB_DIR="$BUILD_DIR/lib/.libs"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG_FILE="$LOG_DIR/dock-e-autostart.log"

mkdir -p "$LOG_DIR"

{
  printf '\n[%s] Dock-e autostart invoked\n' "$(date -Is)"

  if pgrep -u "$(id -u)" -f "$DOCK_E" >/dev/null 2>&1; then
    echo "Dock-e is already running"
    exit 0
  fi

  # Give XFCE and the session D-Bus enough time to initialize the tray host.
  sleep 5

  if [ ! -x "$DOCK_E" ]; then
    echo "Dock-e binary not found: $DOCK_E"
    exit 1
  fi

  echo "starting project build: $DOCK_E"
  export LD_LIBRARY_PATH="$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export GSETTINGS_SCHEMA_DIR="$BUILD_DIR/data"
  export PLANK_DOCKLET_DIRS="$BUILD_DIR/docklets"
  exec "$DOCK_E" -n dev -d
} >>"$LOG_FILE" 2>&1
