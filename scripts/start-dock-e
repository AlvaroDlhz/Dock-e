#!/usr/bin/env sh

# Start the out-of-tree project build of Dock-E for the desktop session.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
BUILD_DIR=${DOCK_E_BUILD_DIR:-"$PROJECT_DIR/.build"}
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG_FILE="$LOG_DIR/dock-e-autostart.log"

mkdir -p "$LOG_DIR"

{
  printf '\n[%s] Dock-e autostart invoked\n' "$(date -Is)"

  if pgrep -u "$(id -u)" -f "plank.*-n dev" >/dev/null 2>&1 || pgrep -u "$(id -u)" -f "$PROJECT_DIR/src/.libs/plank" >/dev/null 2>&1 || pgrep -u "$(id -u)" -f "$BUILD_DIR/src/.libs/plank" >/dev/null 2>&1; then
    echo "Dock-e is already running"
    exit 0
  fi

  # Give XFCE and the session D-Bus enough time to initialize the tray host.
  sleep 5

  # Try build dir first, else use in-tree build
  if [ -x "$BUILD_DIR/src/.libs/plank" ]; then
    DOCK_E="$BUILD_DIR/src/.libs/plank"
    LIB_DIR="$BUILD_DIR/lib/.libs"
    GSETTINGS_SCHEMA_DIR="$BUILD_DIR/data"
    PLANK_DOCKLET_DIRS="$BUILD_DIR/docklets"
  elif [ -x "$PROJECT_DIR/src/.libs/plank" ]; then
    DOCK_E="$PROJECT_DIR/src/.libs/plank"
    LIB_DIR="$PROJECT_DIR/lib/.libs"
    GSETTINGS_SCHEMA_DIR="$PROJECT_DIR/data"
    PLANK_DOCKLET_DIRS="$PROJECT_DIR/docklets"
  else
    echo "Dock-e binary not found in expected locations"
    echo "  tried: $BUILD_DIR/src/.libs/plank"
    echo "  tried: $PROJECT_DIR/src/.libs/plank"
    exit 1
  fi

  echo "starting: $DOCK_E"
  [ -d "$LIB_DIR" ] && export LD_LIBRARY_PATH="$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  [ -d "$GSETTINGS_SCHEMA_DIR" ] && export GSETTINGS_SCHEMA_DIR="$GSETTINGS_SCHEMA_DIR"
  [ -d "$PLANK_DOCKLET_DIRS" ] && export PLANK_DOCKLET_DIRS="$PLANK_DOCKLET_DIRS"
  exec "$DOCK_E" -n dev -d
} >>"$LOG_FILE" 2>&1
