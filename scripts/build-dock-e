#!/usr/bin/env sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
BUILD_DIR=${DOCK_E_BUILD_DIR:-"$PROJECT_DIR/.build"}
JOBS=${DOCK_E_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '2')}

if [ -f "$PROJECT_DIR/config.status" ]; then
	echo "An old in-source build was detected." >&2
	echo "Run 'make distclean' in $PROJECT_DIR once, then retry." >&2
	exit 2
fi

mkdir -p "$BUILD_DIR"

if [ ! -f "$BUILD_DIR/Makefile" ]; then
	echo "Configuring Dock-E in $BUILD_DIR"
	# DOCK_E_CONFIGURE_FLAGS is intentionally word-split to accept several flags.
	# shellcheck disable=SC2086
	(cd "$BUILD_DIR" && "$PROJECT_DIR/configure" ${DOCK_E_CONFIGURE_FLAGS:-})
fi

echo "Building Dock-E with $JOBS job(s)"
exec make -C "$BUILD_DIR" -j "$JOBS" "$@"
